        {
          "id": "tool-none",
          "type": "mcp-tool",
          "title": "delete_one",
          "plane": "mcp--surface",
          "fields": {
            "confirmation": "none",
            "effect": "destructive"
          }
        },
        {
          "id": "tool-prompted",
          "type": "mcp-tool",
          "title": "delete_job",
          "plane": "mcp--surface",
          "fields": {
            "confirmation": "client-prompts",
            "effect": "destructive"
          }
        },
        {
          "id": "tool-read",
          "type": "mcp-tool",
          "title": "list_jobs",
          "plane": "mcp--surface",
          "fields": {
